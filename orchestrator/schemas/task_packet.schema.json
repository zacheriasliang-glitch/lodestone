{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "generated_at_utc",
    "experiment",
    "goal",
    "repository_root",
    "observed_state_sha256",
    "next_action"
  ],
  "properties": {
    "packet_version": {
      "type": "string",
      "minLength": 3
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z$"
    },
    "experiment": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "goal": {
      "type": "string",
      "minLength": 4
    },
    "repository_root": {
      "type": "string",
      "minLength": 1
    },
    "observed_state_sha256": {
      "type": "string",
      "minLength": 16
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_state",
        "proposed_next_action",
        "target_files",
        "protected_files",
        "approval_requirement",
        "stop_condition"
      ],
      "properties": {
        "observed_state": {
          "type": "string",
          "minLength": 10
        },
        "proposed_next_action": {
          "type": "string",
          "minLength": 12
        },
        "target_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_requirement": {
          "type": "string",
          "minLength": 5
        },
        "stop_condition": {
          "type": "string",
          "minLength": 6
        },
        "risk_notes": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      }
    }
  }
}
