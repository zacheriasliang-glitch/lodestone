#!/usr/bin/env python3
"""One Nurarihyon learning-organ reconciliation; never launches a model."""
import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))
from lodestone_nurarihyon.learning import reconcile
from lodestone_nurarihyon.common import read_bytes, strict_json, sync_directory

p = argparse.ArgumentParser()
p.add_argument("--config", required=True)
p.add_argument("--status-path", required=True)
a = p.parse_args()
os.umask(0o077)
try:
    config = strict_json(read_bytes(a.config))
    if config.get("schema") != "lodestone-learning-active/v1" or config.get("required") is not True:
        raise ValueError("Required active learning configuration missing")
    home = Path(a.config).parent
    if (home / "STOP").exists():
        result = {"status": "STOPPED", "runs": [], "pending": [], "provider_calls": 0}
    else:
        result = reconcile(config["memory_workspace"])
    status = {"schema": "nurarihyon-learning-observer/v1",
              "observed_at": datetime.now(timezone.utc).isoformat(),
              "status": result["status"], "reconciled_runs": len(result["runs"]),
              "pending_runs": len(result.get("pending", [])), "provider_calls": 0,
              "automatic_retry": False}
except Exception as error:
    status = {"schema": "nurarihyon-learning-observer/v1",
              "observed_at": datetime.now(timezone.utc).isoformat(),
              "status": "ATTENTION", "error_type": type(error).__name__, "provider_calls": 0}
target = Path(a.status_path)
if target.is_symlink() or not target.parent.is_dir():
    raise ValueError("An ordinary status path with existing parent is required")
temporary = None
try:
    with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as stream:
        temporary = Path(stream.name)
        stream.write(json.dumps(status, sort_keys=True).encode("utf-8"))
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, target)
    sync_directory(target.parent)
finally:
    if temporary is not None:
        temporary.unlink(missing_ok=True)
raise SystemExit(2 if status["status"] == "ATTENTION" else 0)
