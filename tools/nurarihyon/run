#!/usr/bin/env python3
"""Checkout-local launcher; no installed package or service required."""
from pathlib import Path
import sys

if sys.version_info < (3, 10):
    raise SystemExit("Python 3.10 or later is required")
if sys.platform != "darwin" and not sys.platform.startswith("linux"):
    raise SystemExit("This toolkit requires macOS or Linux; Windows supports the existing portable preview commands only")
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))
try:
    from lodestone_nurarihyon.__main__ import main
except ImportError:
    if len(sys.argv) > 3 and sys.argv[1] == "--home" and sys.argv[3] == "daemon":
        print('{"stage":"DAEMON_IMPORT","error":"ImportError"}', file=sys.stderr)
        raise SystemExit(70)
    raise

raise SystemExit(main())
