{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lodestone Local Memory Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "body",
    "source",
    "kind",
    "tags",
    "confidence",
    "created_at",
    "updated_at",
    "content_hash",
    "superseded_by"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
